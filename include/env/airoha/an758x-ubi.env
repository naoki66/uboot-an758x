/*
 * Shared UBI lifecycle for Airoha NAND boards.
 *
 * Boot-chain and system commands use the fixed volume names shared by the
 * recovery service and Linux images. Board-data geometry lives in the DTB.
 */
#ifdef CONFIG_CMD_HTTPD
bootcmd=run boot_ubi
boot_ubi=run boot_production ; echo System boot failed, starting Web recovery ; run boot_recovery
#else
bootcmd=run boot_production
boot_ubi=run boot_production
#endif
bootdelay=3
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
bootmenu_default=0
bootmenu_delay=3
bootmenu_0=Boot system=run boot_ubi ; run bootmenu_confirm_return
bootmenu_1=Web recovery=run boot_recovery ; run bootmenu_confirm_return
bootmenu_2=Boot initramfs via TFTP=run boot_tftp ; run bootmenu_confirm_return
bootmenu_3=Flash system via TFTP=run boot_tftp_write_production ; run bootmenu_confirm_return
bootmenu_4=Flash U-Boot via TFTP=run boot_tftp_write_fip ; run bootmenu_confirm_return
bootmenu_5=Flash BL2 via TFTP=run boot_tftp_write_bl2 ; run bootmenu_confirm_return
bootmenu_6=Show storage information=mtd list ; run ubi_mount ; ubi info l ; run bootmenu_confirm_return
bootmenu_7=Reboot=reset
boot_production=led $bootled_status on ; run ubi_read_production && bootm $loadaddr
boot_tftp=tftpboot $loadaddr $bootfile && iminfo $loadaddr && bootm $loadaddr
boot_tftp_forever=led $bootled_status on ; while true ; do run boot_tftp ; sleep 1 ; done
boot_tftp_write_bl2=mw.b $loadaddr 0xff 0x20000 ; setexpr loadaddr_bl2 $loadaddr + 0x800 ; tftpboot $loadaddr_bl2 $bootfile_bl2 && run mtd_write_bl2
boot_tftp_write_fip=tftpboot $loadaddr $bootfile_fip && run ubi_write_fip
boot_tftp_write_production=tftpboot $loadaddr $bootfile_upg && iminfo $loadaddr && run ubi_write_production
mtd_write_bl2=itest.l $filesize -le 0x1f800 && mtd erase bl2 && mtd write bl2 $loadaddr 0 0x20000
preboot=led $bootled_status on
ubi_mount=ubi part ubi
ubi_prepare_rootfs=if ubi check rootfs_data; then true; else if env exists rootfs_data_max; then ubi create rootfs_data $rootfs_data_max dynamic || ubi create rootfs_data - dynamic; else ubi create rootfs_data - dynamic; fi; fi
ubi_read_production=run ubi_mount && ubi read $loadaddr fit && iminfo $loadaddr && run ubi_prepare_rootfs
ubi_remove_rootfs=if ubi check rootfs_data; then ubi remove rootfs_data; else true; fi
ubi_verify_fip=setexpr verifyaddr $loadaddr - $filesize ; ubi read $verifyaddr fip $filesize && cmp.b $loadaddr $verifyaddr $filesize
ubi_verify_production=setexpr verifyaddr $loadaddr - $filesize ; ubi read $verifyaddr fit $filesize && cmp.b $loadaddr $verifyaddr $filesize && iminfo $verifyaddr
ubi_write_fip=run ubi_mount && run ubi_remove_rootfs && if ubi check fip; then ubi remove fip; else true; fi && ubi create fip 0x100000 static && ubi write $loadaddr fip $filesize && run ubi_verify_fip
ubi_write_production=run ubi_mount && run ubi_remove_rootfs && if ubi check fit; then ubi remove fit; else true; fi && ubi create fit $filesize dynamic && ubi write $loadaddr fit $filesize && run ubi_verify_production
/*
 * Readback buffer for the UBI write verification.  It is recomputed on every
 * write as verifyaddr = loadaddr - filesize, so the window
 * [verifyaddr, verifyaddr + filesize) always sits directly below the image it
 * verifies and can never overlap it.
 *
 * It must NOT be a fixed buffer above loadaddr.  On a 512 MiB board
 * (0x80000000-0xA0000000) loadaddr 0x90000000 + 128 MiB = 0xA0000000, and the
 * top of DRAM is not free: relocated U-Boot reserves it for its own image, the
 * 4 MiB malloc pool, the stack, gd/bd and the FDT.  Reading a 128 MiB image
 * back into that window overwrites the running U-Boot, so the board dies inside
 * `ubi read` and cmp.b/iminfo never run.  It only starts failing once the image
 * is big enough for the window to reach U-Boot (~121 MiB on a 512 MiB board),
 * which is why smaller images verified fine.  Below loadaddr there are 256 MiB
 * of free DRAM, so the window keeps ~248 MiB of clearance from U-Boot whatever
 * the image size is.
 *
 * filesize is a bare hex string from tftpboot and setexpr parses hex as well,
 * so the plain (32-bit) `name val1 - val2` form is enough.  The fit volume
 * always fits inside the 256 MiB UBI partition, so verifyaddr can never
 * underflow past CFG_SYS_SDRAM_BASE.  The value below is the fallback used
 * before the first write, or when filesize is unset.
 */
verifyaddr=0x88000000
